{
    "layer": "top",
    "height": 36,
    "modules-left": ["custom/power", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["tray", "mpris", "battery", "power-profiles-daemon", "bluetooth", "pulseaudio", "clock"],
    "reload_style_on_change": true,

    "battery": {
        "format": "{icon}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
	"tooltip-format": "{capacity}%"
    },
    "clock": {
        "format": "{:%b %d  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
                    "mode"          : "month",
                    "mode-mon-col"  : 3,
                    "on-scroll"     : 1,
                    "format": {
                              "months":     "<span color='#ffead3'><b>{}</b></span>",
                              "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                              "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                              "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                              "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
                              }
                    }
    },
    "bluetooth": {
        "controller": "bluez",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-on": "",
        "format-connected": "󰂱",
        "on-click": "pgrep blueman-manager && pkill blueman-manager || blueman-manager"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": 
        {
            "default": "󰾅",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        },
        "tooltip": true
    },
    "pulseaudio": {
        "format": "{icon} {volume}%", 
        "format-icons": ["󰕿","󰖀", "󰕾"],
        "scroll-step": 2.0,
        "format-muted": "󰖁 {volume}%",
        "on-click":"pgrep pavucontrol && pkill pavucontrol || pavucontrol",
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "network": {
        "format": "",
        "tooltip": "enabled",
        "tooltip-format-ethernet": "",
        "tooltip-format-wifi": "{essid} {frequency}",
        "tooltip-format-disconnected": "Not connected",
        "format-wifi": "󰖩",
        "format-ethernet": "󰌗",
        "on-click": "pgrep nm-connection && pkill nm-connection || nm-connection-editor"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces":
        {
            "*": 3
        }
    },
    "custom/power": {
        "format": "",
        "tooltip-format": "Power/session",
        "on-click": "nwg-bar"
    },
    "custom/kblayout": {
	"exec": ".config/hypr/scripts/kbl.sh",
	"interval": 3,
	"format": "{}"
    },
    "mpris": {

        "min-length": 30,
        "dynamic-len": 24,
	    "format": "{player_icon}  {dynamic}",
	    "format-paused": "{status_icon} <i>{dynamic}</i>",
	    "player-icons": {
            "firefox": "󰖟",
		"default": "▶",
		"spotify": "",
        "vlc": "󰕼"
	    },
	    "status-icons": {
		    "paused": ""
	    },
        "interval": 1
        
	// "ignored-players": ["firefox"]
    },
    "hyprland/window": {
        "rewrite": {
            "(.*) — Mozilla Firefox" : "Firefox",
            "(.*) — Zen Browser" : "Zen Browser",
            "(.*) - Visual Studio Code" : "Visual Studio Code",
	    "(.*) - Discord": "Discord",
            "": "win + r to start"
        }
    },

    "wlr/taskbar": {
        "on-click": "minimize-raise"
    }
}

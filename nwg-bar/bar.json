[
  {
    "label": "Logout",
    "exec": "hyprctl dispatch exit",
    "icon": "/usr/share/icons/Adwaita/symbolic/actions/system-log-out-symbolic.svg"
  },
  {
    "label": "Reboot",
    "exec": "systemctl reboot",
    "icon": "/usr/share/icons/Adwaita/symbolic/actions/system-reboot-symbolic.svg"
  },
  {
    "label": "Shutdown",
    "exec": "systemctl -i poweroff",
    "icon": "/usr/share/icons/Adwaita/symbolic/actions/system-shutdown-symbolic.svg"
  }
]